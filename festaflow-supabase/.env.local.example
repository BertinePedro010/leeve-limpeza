# E-mail (opcional) — sem essas variaveis, o envio ao concluir um atendimento
# e o envio manual de OS por e-mail (tela de Ordens de Servico) sao apenas
# ignorados/bloqueados com mensagem clara ao usuario, nunca quebram a
# aplicacao. Qualquer SMTP funciona (Gmail, SendGrid SMTP, Mailtrap, SES SMTP).
# EMAIL_FROM ja aceita o formato "Nome <endereco>" nativamente - e o que
# aparece como remetente para o cliente, nunca o e-mail pessoal de quem enviou.
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT="587"
SMTP_USER="usuario_smtp"
SMTP_PASS="senha_smtp"
EMAIL_FROM="LeeveLimpeza <contato@leevelimpeza.com>"
